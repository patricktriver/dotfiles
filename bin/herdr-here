#!/bin/sh
# Run a command from a herdr popup in the project of the pane you were in:
# its git root if it's in a repo, otherwise its folder.
# Usage: herdr-here fresh   |   herdr-here critique
dir="${HERDR_ACTIVE_PANE_CWD:-$PWD}"
[ -d "$dir" ] || dir="$HOME"
root=$(git -C "$dir" rev-parse --show-toplevel 2>/dev/null) && dir="$root"
cd "$dir" || exit 1

"$@"
status=$?

# Keep the popup open on failure so the error is readable.
if [ "$status" -ne 0 ]; then
  printf '\n[%s exited %s in %s] press Enter to close ' "$1" "$status" "$dir"
  read -r _
fi
exit "$status"
